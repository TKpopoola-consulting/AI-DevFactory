# Gemini API Key - Get from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aidevfactory
REDIS_HOST=localhost
REDIS_PORT=6379

# Agent URLs (for communication between services)
FRONTEND_AGENT_URL=http://localhost:5001
BACKEND_AGENT_URL=http://localhost:5002
INFRA_AGENT_URL=http://localhost:5003
QA_AGENT_URL=http://localhost:5004

# Application Settings
DEBUG=true
ENVIRONMENT=development
PORT=8000
